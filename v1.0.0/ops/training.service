[Unit]
Description=MW-NV shared PPO and NIM teacher
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=mwnv
WorkingDirectory=/opt/MW_NV/v1.0.0
EnvironmentFile=/etc/mw-nv/training.env
Environment=OMP_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
Environment=MPLCONFIGDIR=/var/lib/mw-nv/mpl
Environment=XDG_CACHE_HOME=/var/lib/mw-nv/cache
ExecStart=/opt/MW_NV/v1.0.0/.venv/bin/python -u -m learning.self_play --root data/self-play-v3 --seed-policy data/self-play-v3/seed.zip
Restart=on-failure
RestartSec=15
KillSignal=SIGINT
TimeoutStopSec=90
CPUQuota=200%
UMask=0077

[Install]
WantedBy=multi-user.target
